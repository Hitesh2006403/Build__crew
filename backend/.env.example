# Server Configuration
PORT=5000

# MongoDB Atlas Connection URI (Required on Vercel)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?appName=BuildCrewCluster

# JSON Web Token Secret (Required on Vercel)
JWT_SECRET=your_jwt_secret_key_here

# Frontend URL & App URL for CORS & Email Links (e.g., https://your-project.vercel.app)
FRONTEND_URL=https://your-frontend.vercel.app
APP_URL=https://your-frontend.vercel.app

# Automated Hackathon Ingestion (Optional)
# Set to "true" to disable the background Karnataka-hackathon sync (startup +
# 6-hourly scheduler, cron-sync endpoint, and opportunistic refresh).
# Useful in environments without outbound network access. Default "false":
# sync runs as before. Chat, auth, and all other features are unaffected.
DISABLE_HACKATHON_SYNC=false

# Founder Administrators (Optional initial seeding)
ADMIN1_EMAIL=your_email@domain.com
ADMIN1_PASSWORD=your_secure_password
ADMIN2_EMAIL=collaborator_email@domain.com
ADMIN2_PASSWORD=collaborator_secure_password

# Google OAuth (Optional - for Google Sign-in verification on backend)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP Email Configuration for Team Invitations (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
EMAIL_FROM="BuildCrew Platform" <no-reply@buildcrew.com>
