# Frontend Environment Variables

# Backend API URL (Optional on Vercel fullstack deployment as relative '/api' is default.
# Required if backend is deployed separately, e.g., https://your-backend.vercel.app/api)
VITE_API_URL=

# Socket.IO server URL (Optional. Required for true real-time chat when the
# backend runs separately from the frontend, e.g. https://your-backend.onrender.com.
# NOTE: Vercel serverless functions cannot hold WebSocket connections, so on a
# single-domain Vercel deployment the app falls back to auto-polling while the
# socket is disconnected. For instant delivery, host the backend on a
# persistent Node.js host (Render/Railway/Fly/VPS) and set both VITE_API_URL
# and VITE_SOCKET_URL to that backend URL.)
VITE_SOCKET_URL=

# Google OAuth 2.0 Client ID for Google Identity Services / Account Chooser
# Format: <your-client-id>.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=
